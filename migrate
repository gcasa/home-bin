#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  migrate [options] TYPE:PATH [TYPE:PATH ...]
  migrate [options] --manifest FILE
  migrate [options] --all

Migrate apps and libraries into prefix-named directories such as app-foo,
libs-bar, tool-baz, like the split layout used by GNUstep-related repos.
Each migrated directory is initialized as its own Git repository by default.

Examples:
  migrate app:ProjectCenter libs:BaseKit
  migrate --execute --root ../gnustep app:TextEdit libs:ObjCRuntime
  migrate --copy --manifest migrate.txt
  migrate --all --from ./GNUstep --root ../split-repos

Manifest format:
  # TYPE PATH [DEST_NAME]
  app  ./ProjectCenter
  libs ./BaseKit GNUstepBase
  tool ./build-helper

Options:
  -r, --root DIR       Destination root directory. Default: current directory.
  -f, --from DIR       Source root for relative paths. Default: current directory.
  -m, --manifest FILE  Read migration entries from FILE.
  -a, --all            Scan source root category directories for projects.
  -x, --execute        Actually perform the migration. Default is dry run.
  -n, --dry-run        Print planned operations without changing files.
  -c, --copy           Copy instead of move.
  --no-git             Do not run git init in each destination directory.
  -b, --branch NAME    Initial branch name for git init, such as main.
  --force              Allow existing empty destination directories.
  -h, --help           Show this help.

Entry forms:
  TYPE:PATH            Destination name is basename(PATH).
  TYPE:PATH=DEST_NAME  Destination name is DEST_NAME.

Common TYPE values are app, apps, lib, libs, library, framework, tool, tests,
docs, example, service, daemon, bundle, and game.

--all scans direct child directories below common category directories in the
source root, such as apps/*, tools/*, libs/*, frameworks/*, tests/*, and docs/*.
EOF
}

die() {
    printf 'migrate: %s\n' "$*" >&2
    exit 1
}

info() {
    printf '%s\n' "$*"
}

lowercase() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

prefix_for_type() {
    case "$1" in
        app|apps|application|applications)
            printf 'app'
            ;;
        lib|libs|library|libraries)
            printf 'libs'
            ;;
        framework|frameworks)
            printf 'frameworks'
            ;;
        tool|tools|utility|utilities)
            printf 'tool'
            ;;
        test|tests)
            printf 'tests'
            ;;
        doc|docs|documentation)
            printf 'docs'
            ;;
        example|examples|sample|samples)
            printf 'examples'
            ;;
        service|services)
            printf 'service'
            ;;
        daemon|daemons)
            printf 'daemon'
            ;;
        bundle|bundles)
            printf 'bundle'
            ;;
        game|games)
            printf 'game'
            ;;
        *)
            die "unknown type '$1' (use app, libs, framework, tool, tests, docs, examples, service, daemon, bundle, or game)"
            ;;
    esac
}

is_empty_dir() {
    [ -d "$1" ] && [ -z "$(find "$1" -mindepth 1 -maxdepth 1 -print -quit)" ]
}

append_scanned_entries() {
    local source_root=$1
    local type_dir type path base
    local category_dirs=(
        app apps applications
        lib libs libraries
        framework frameworks
        tool tools utilities
        test tests
        doc docs documentation
        example examples samples
        service services
        daemon daemons
        bundle bundles
        game games
    )

    for type_dir in "${category_dirs[@]}"; do
        [ -d "$source_root/$type_dir" ] || continue
        type=$(prefix_for_type "$type_dir")

        while IFS= read -r -d '' path; do
            base=$(basename "$path")
            ENTRIES+=("$type"$'\t'"$type_dir/$base"$'\t'"$base")
        done < <(find "$source_root/$type_dir" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
    done
}

append_entry() {
    local entry=$1
    local type path name

    case "$entry" in
        *:*)
            type=${entry%%:*}
            path=${entry#*:}
            ;;
        *)
            die "entry '$entry' must use TYPE:PATH or TYPE:PATH=DEST_NAME"
            ;;
    esac

    if [[ "$path" == *=* ]]; then
        name=${path#*=}
        path=${path%%=*}
    else
        name=$(basename "$path")
    fi

    [ -n "$type" ] || die "entry '$entry' has an empty type"
    [ -n "$path" ] || die "entry '$entry' has an empty path"
    [ -n "$name" ] || die "entry '$entry' has an empty destination name"

    ENTRIES+=("$type"$'\t'"$path"$'\t'"$name")
}

append_manifest() {
    local manifest=$1
    local line_no=0
    local type path name rest

    [ -f "$manifest" ] || die "manifest '$manifest' does not exist"

    while IFS= read -r line || [ -n "$line" ]; do
        line_no=$((line_no + 1))
        line=${line%%#*}
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        [ -n "$line" ] || continue

        read -r type path name rest <<<"$line"
        [ -z "${rest:-}" ] || die "$manifest:$line_no has too many columns"
        [ -n "${type:-}" ] && [ -n "${path:-}" ] || die "$manifest:$line_no must contain TYPE PATH [DEST_NAME]"

        if [ -n "${name:-}" ]; then
            ENTRIES+=("$type"$'\t'"$path"$'\t'"$name")
        else
            ENTRIES+=("$type"$'\t'"$path"$'\t'"$(basename "$path")")
        fi
    done < "$manifest"
}

ROOT=.
FROM=.
DRY_RUN=1
COPY=0
FORCE=0
INIT_GIT=1
GIT_BRANCH=
SCAN_ALL=0
MANIFEST=
ENTRIES=()

while [ $# -gt 0 ]; do
    case "$1" in
        -r|--root)
            [ $# -ge 2 ] || die "$1 requires a directory"
            ROOT=$2
            shift 2
            ;;
        -f|--from)
            [ $# -ge 2 ] || die "$1 requires a directory"
            FROM=$2
            shift 2
            ;;
        -m|--manifest)
            [ $# -ge 2 ] || die "$1 requires a file"
            MANIFEST=$2
            shift 2
            ;;
        -a|--all)
            SCAN_ALL=1
            shift
            ;;
        -x|--execute)
            DRY_RUN=0
            shift
            ;;
        -n|--dry-run)
            DRY_RUN=1
            shift
            ;;
        -c|--copy)
            COPY=1
            shift
            ;;
        --no-git)
            INIT_GIT=0
            shift
            ;;
        -b|--branch)
            [ $# -ge 2 ] || die "$1 requires a branch name"
            GIT_BRANCH=$2
            shift 2
            ;;
        --force)
            FORCE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            while [ $# -gt 0 ]; do
                append_entry "$1"
                shift
            done
            ;;
        -*)
            die "unknown option '$1'"
            ;;
        *)
            append_entry "$1"
            shift
            ;;
    esac
done

if [ -n "$MANIFEST" ]; then
    append_manifest "$MANIFEST"
fi

[ -d "$FROM" ] || die "source root '$FROM' does not exist"

if [ "$SCAN_ALL" -eq 1 ]; then
    append_scanned_entries "$FROM"
fi

[ "${#ENTRIES[@]}" -gt 0 ] || {
    usage >&2
    exit 1
}

if [ "$DRY_RUN" -eq 1 ]; then
    info "Dry run. Re-run with --execute to apply these changes."
fi

DESTS=()
for entry in "${ENTRIES[@]}"; do
    IFS=$'\t' read -r type rel_path dest_name <<<"$entry"
    prefix=$(prefix_for_type "$type")
    dest_leaf=$(lowercase "$prefix-$dest_name")
    source_path=$rel_path

    if [[ "$source_path" != /* ]]; then
        source_path=$FROM/$source_path
    fi

    dest_path=$ROOT/$dest_leaf

    [ -e "$source_path" ] || die "source '$source_path' does not exist"
    [ -d "$source_path" ] || die "source '$source_path' is not a directory"

    for seen_dest in "${DESTS[@]}"; do
        [ "$seen_dest" != "$dest_path" ] || die "multiple entries target destination '$dest_path'"
    done
    DESTS+=("$dest_path")

    if [ -e "$dest_path" ] && { [ "$FORCE" -eq 0 ] || ! is_empty_dir "$dest_path"; }; then
        die "destination '$dest_path' already exists"
    fi
done

mkdir_cmd=(mkdir -p "$ROOT")
if [ "$DRY_RUN" -eq 1 ]; then
    info "+ ${mkdir_cmd[*]}"
else
    "${mkdir_cmd[@]}"
fi

for entry in "${ENTRIES[@]}"; do
    IFS=$'\t' read -r type rel_path dest_name <<<"$entry"
    prefix=$(prefix_for_type "$type")
    dest_leaf=$(lowercase "$prefix-$dest_name")
    source_path=$rel_path

    if [[ "$source_path" != /* ]]; then
        source_path=$FROM/$source_path
    fi

    dest_path=$ROOT/$dest_leaf

    if [ -e "$dest_path" ]; then
        if [ "$FORCE" -eq 1 ] && is_empty_dir "$dest_path"; then
            rmdir_cmd=(rmdir "$dest_path")
            info "+ ${rmdir_cmd[*]}"
            if [ "$DRY_RUN" -eq 0 ]; then
                "${rmdir_cmd[@]}"
            fi
        else
            die "destination '$dest_path' already exists"
        fi
    fi

    if [ "$COPY" -eq 1 ]; then
        cmd=(cp -R "$source_path" "$dest_path")
    else
        cmd=(mv "$source_path" "$dest_path")
    fi

    info "+ ${cmd[*]}"
    if [ "$DRY_RUN" -eq 0 ]; then
        "${cmd[@]}"
    fi

    if [ "$INIT_GIT" -eq 1 ]; then
        if [ -n "$GIT_BRANCH" ]; then
            git_cmd=(git -C "$dest_path" init -b "$GIT_BRANCH")
        else
            git_cmd=(git -C "$dest_path" init)
        fi
        info "+ ${git_cmd[*]}"
        if [ "$DRY_RUN" -eq 0 ]; then
            "${git_cmd[@]}"
        fi
    fi
done

exit 0
